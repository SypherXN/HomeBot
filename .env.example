# =============================================================================
# HomeBot — environment template (copy to ".env" and fill in; never commit .env)
# =============================================================================
# The .NET app reads the PROCESS environment only. It does NOT load this file
# automatically. Options:
#   • Cursor / VS Code: set "envFile": "${workspaceFolder}/.env" in launch.json
#     for debugging, or paste variables into a terminal before `dotnet run`.
#   • PowerShell (session):  $env:DISCORD_TOKEN = "..." ; dotnet run
#   • Windows Task Scheduler: run scripts/run-homebot.ps1 (loads this file then dotnet run)
#   • systemd / Docker / hosting panel: use their native env configuration.
# See docs/SETUP.md and README.md for full explanations.
# =============================================================================

# --- Mode (set explicitly when you need API-only or similar) ---
# HOMEBOT_DISCORD_ENABLED=true
# HOMEBOT_API_ENABLED=true

# --- Discord bot (required when Discord is enabled) ---
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# --- HTTP API ---
# Listen URL (default http://0.0.0.0:5050)
# HOMEBOT_API_URL=http://0.0.0.0:5050
# Bearer for scripts / non-JWT clients (optional if you only use web JWT login)
HOMEBOT_API_TOKEN=
# Browser CORS; comma-separated. If unset, only http://localhost:5173 is allowed.
# HOMEBOT_ALLOWED_ORIGINS=http://localhost:5173,https://your-spa.example.com
# HOMEBOT_DATABASE_PATH=homebot.db
# HOMEBOT_API_MAX_BODY_BYTES=
# HOMEBOT_API_MUTATION_PERMIT_LIMIT=
# Per-IP auth rate limits (optional; see README "Auth rate limits")
# HOMEBOT_API_AUTH_LOGIN_PER_MINUTE=
# HOMEBOT_API_OAUTH_CONSUME_PER_MINUTE=
# HOMEBOT_API_OAUTH_BROWSER_PER_MINUTE=
# HOMEBOT_API_AUTH_ACCOUNT_WRITE_PER_MINUTE=
# HOMEBOT_API_DISCORD_STATUS_POLL_PER_MINUTE=
# HOMEBOT_API_AUTH_REFRESH_PER_MINUTE=
# Non-Development only: allow incomplete OAuth triple without failing startup (default: must be complete or unset)
# HOMEBOT_ALLOW_PARTIAL_OAUTH_ENV=true

# --- Web login (JWT) — required for password login, Discord verify signup, OAuth ---
# Min 32 UTF-8 bytes; server-only, never in the frontend bundle.
HOMEBOT_WEB_JWT_SECRET=
# Access JWT lifetime (seconds, default 900). Refresh tokens use WebRefreshTokens in SQLite.
# HOMEBOT_WEB_JWT_ACCESS_TTL_SECONDS=
# HOMEBOT_WEB_REFRESH_TTL_SECONDS=
# HOMEBOT_WEB_SETUP_TOKEN=
# HOMEBOT_WEB_INVITE_TOKEN=

# --- Discord OAuth (optional "Continue with Discord" on Sign in) ---
# All three must be set together. Redirect URI must match Discord Developer Portal
# OAuth2 → Redirects EXACTLY (including http vs https, port, path, no trailing slash mismatch).
# HOMEBOT_DISCORD_OAUTH_CLIENT_ID=
# HOMEBOT_DISCORD_OAUTH_CLIENT_SECRET=
# Typical local redirect (API host, not the Vite URL):
# HOMEBOT_DISCORD_OAUTH_REDIRECT_URI=http://localhost:5050/api/auth/discord/oauth/callback
# Where the SPA is served after Discord redirects (origin only; default if unset: http://localhost:5173)
# HOMEBOT_WEB_OAUTH_FRONTEND_URL=http://localhost:5173

# --- Calendar reminders (optional) ---
# Background poll interval in seconds when Discord is connected (default 30, min 10, max 300).
# HOMEBOT_REMINDER_POLL_SECONDS=30

# --- Budget (optional) ---
# Large-expense alert threshold in USD (default 500)
# HOMEBOT_BUDGET_LARGE_EXPENSE_USD=500
# Weekly digest: weekday name (Sunday … Saturday) or 0–6 (Sunday = 0); hour in UTC 0–23
# HOMEBOT_BUDGET_DIGEST_DAY=Sunday
# HOMEBOT_BUDGET_DIGEST_UTC_HOUR=17

# --- Off-site backup: Google Drive via rclone (optional) ---
# Install rclone on the server; run "rclone config" once to add a Google Drive remote.
# Use scripts/backup-homebot-with-gdrive.sh or systemd homebot-backup-with-gdrive.*.example
# HOMEBOT_GDRIVE_BACKUP_ENABLED=true
# HOMEBOT_GDRIVE_RCLONE_REMOTE=gdrive
# HOMEBOT_GDRIVE_BACKUP_PATH=HomeBot/backups
# HOMEBOT_GDRIVE_RETENTION_DAYS=90
# HOMEBOT_LOCAL_BACKUP_RETENTION_DAYS=30
# HOMEBOT_BACKUP_DIR=/opt/homebot/backups
# HOMEBOT_GDRIVE_BACKUP_DRY_RUN=true
# Encrypt backups before upload (requires gpg on the host). Plaintext copies remain locally for restore.
# HOMEBOT_GDRIVE_BACKUP_ENCRYPT=true
# HOMEBOT_GDRIVE_BACKUP_ENCRYPT_PASSPHRASE_FILE=/opt/homebot/backup-passphrase.txt

# --- Medium features (optional) ---
# Also DM assigned users for calendar reminders (in addition to the calendar channel).
# HOMEBOT_CALENDAR_REMINDER_DM=true
# Buy recurring worker poll interval in minutes (default 60).
# HOMEBOT_BUY_RECURRING_POLL_MINUTES=60
# Webhook secret for POST /api/hooks/buy/add (header X-HomeBot-Webhook-Secret).
# HOMEBOT_WEBHOOK_SECRET=
# Comma-separated Discord user ids granted web admin (in addition to IsAdmin web users).
# HOMEBOT_WEB_ADMIN_DISCORD_IDS=

# --- Google Calendar two-way sync (optional) ---
# Create OAuth client in Google Cloud Console (Web application redirect URI must match).
# HOMEBOT_GOOGLE_OAUTH_CLIENT_ID=
# HOMEBOT_GOOGLE_OAUTH_CLIENT_SECRET=
# HOMEBOT_GOOGLE_OAUTH_REDIRECT_URI=https://your-host/api/calendar/google/oauth/callback
# HOMEBOT_GOOGLE_CALENDAR_SYNC_MINUTES=15
# HOMEBOT_GOOGLE_SYNC_CONFLICT=newest
# google | local | newest — when both sides changed before sync

# --- Budget notifications (optional) ---
# HOMEBOT_BUDGET_DIGEST_TO_CHANNEL=true
# HOMEBOT_BUDGET_ALERTS_TO_CHANNEL=true

# --- Web Push (PWA notifications; optional) ---
# Generate keys: npx web-push generate-vapid-keys
# HOMEBOT_VAPID_PUBLIC_KEY=
# HOMEBOT_VAPID_PRIVATE_KEY=
# HOMEBOT_VAPID_SUBJECT=mailto:you@example.com
