# =============================================================================
# HomeBot — environment template (copy to ".env" and fill in; never commit .env)
# =============================================================================
# The .NET app reads the PROCESS environment only. It does NOT load this file
# automatically. Options:
#   • Cursor / VS Code: set "envFile": "${workspaceFolder}/.env" in launch.json
#     for debugging, or paste variables into a terminal before `dotnet run`.
#   • PowerShell (session):  $env:DISCORD_TOKEN = "..." ; dotnet run
#   • systemd / Docker / hosting panel: use their native env configuration.
# See README.md "Configuration" for full explanations.
# =============================================================================

# --- Mode (set explicitly when you need API-only or similar) ---
# HOMEBOT_DISCORD_ENABLED=true
# HOMEBOT_API_ENABLED=true

# --- Discord bot (required when Discord is enabled) ---
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# --- HTTP API ---
# Listen URL (default http://0.0.0.0:5050)
# HOMEBOT_API_URL=http://0.0.0.0:5050
# Bearer for scripts / non-JWT clients (optional if you only use web JWT login)
HOMEBOT_API_TOKEN=
# Browser CORS; comma-separated. If unset, only http://localhost:5173 is allowed.
# HOMEBOT_ALLOWED_ORIGINS=http://localhost:5173,https://your-spa.example.com
# HOMEBOT_DATABASE_PATH=homebot.db
# HOMEBOT_API_MAX_BODY_BYTES=
# HOMEBOT_API_MUTATION_PERMIT_LIMIT=
# Per-IP auth rate limits (optional; see README "Auth rate limits")
# HOMEBOT_API_AUTH_LOGIN_PER_MINUTE=
# HOMEBOT_API_OAUTH_CONSUME_PER_MINUTE=
# HOMEBOT_API_OAUTH_BROWSER_PER_MINUTE=
# HOMEBOT_API_AUTH_ACCOUNT_WRITE_PER_MINUTE=
# HOMEBOT_API_DISCORD_STATUS_POLL_PER_MINUTE=
# HOMEBOT_API_AUTH_REFRESH_PER_MINUTE=
# Non-Development only: allow incomplete OAuth triple without failing startup (default: must be complete or unset)
# HOMEBOT_ALLOW_PARTIAL_OAUTH_ENV=true

# --- Web login (JWT) — required for password login, Discord verify signup, OAuth ---
# Min 32 UTF-8 bytes; server-only, never in the frontend bundle.
HOMEBOT_WEB_JWT_SECRET=
# Access JWT lifetime (seconds, default 900). Refresh tokens use WebRefreshTokens in SQLite.
# HOMEBOT_WEB_JWT_ACCESS_TTL_SECONDS=
# HOMEBOT_WEB_REFRESH_TTL_SECONDS=
# HOMEBOT_WEB_SETUP_TOKEN=
# HOMEBOT_WEB_INVITE_TOKEN=

# --- Discord OAuth (optional "Continue with Discord" on Sign in) ---
# All three must be set together. Redirect URI must match Discord Developer Portal
# OAuth2 → Redirects EXACTLY (including http vs https, port, path, no trailing slash mismatch).
# HOMEBOT_DISCORD_OAUTH_CLIENT_ID=
# HOMEBOT_DISCORD_OAUTH_CLIENT_SECRET=
# Typical local redirect (API host, not the Vite URL):
# HOMEBOT_DISCORD_OAUTH_REDIRECT_URI=http://localhost:5050/api/auth/discord/oauth/callback
# Where the SPA is served after Discord redirects (origin only; default if unset: http://localhost:5173)
# HOMEBOT_WEB_OAUTH_FRONTEND_URL=http://localhost:5173
