# API origin for fetch() calls. Must match where HomeBot listens (see repo README: HOMEBOT_API_URL).
VITE_API_BASE_URL=http://localhost:5050
# For GitHub Pages project repos, set e.g. /HomeBot/
VITE_BASE_PATH=/
# After Discord OAuth, the server redirects to VITE origin + /oauth/callback — that origin must match
# HOMEBOT_WEB_OAUTH_FRONTEND_URL on the API (repo root .env.example).
